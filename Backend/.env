PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/decentralized_will

# Auth
JWT_SECRET=change_this_to_a_random_32_char_string_now
JWT_EXPIRES_IN=7d

# Encryption (for IPFS will data — Phase 3)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# Blockchain (Phase 2)
RPC_URL=http://localhost:8545
DEPLOYER_PRIVATE_KEY=
WILL_FACTORY_ADDRESS=

# IPFS (Phase 3)
IPFS_PROJECT_ID=
IPFS_PROJECT_SECRET=
IPFS_GATEWAY=https://ipfs.infura.io/ipfs/

# Dead Man Switch (Phase 7)
PING_INTERVAL_DAYS=30
CHECK_INTERVAL_CRON=0 0 * * *
